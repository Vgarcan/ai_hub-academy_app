# ============================================================
# AI Hub Academy — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .one-env.example .env          (macOS / Linux)
#   copy .one-env.example .env        (Windows)
#
# The setup script (python setup_dev.py) does this automatically
# and generates a secure SECRET_KEY for you.
# ============================================================

# ── Django core ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# Production defaults become secure automatically when DEBUG=False. Set HSTS
# only after confirming the entire deployment is permanently HTTPS.
SECURE_HSTS_SECONDS=0
# Enable these only when every subdomain is permanently HTTPS and the domain
# is ready for browser preload registration.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Anonymous assistant calls may incur provider cost. Enable only behind rate limiting.
ACADEMY_ASSISTANT_ALLOW_ANONYMOUS=False

# ============================================================
# Database
# ============================================================
# SQLite remains the zero-config local default.
# DATABASE_ENGINE=sqlite
# SQLITE_NAME=C:\path\to\db.sqlite3
#
# PostgreSQL option A: one URL (takes precedence over discrete variables).
# DATABASE_URL=postgresql://ai_hub:change-me@127.0.0.1:5432/ai_hub
#
# PostgreSQL option B: discrete variables.
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=ai_hub
# POSTGRES_USER=ai_hub
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
#
# Use persistent connections deliberately; 0 closes at request end.
# DB_CONN_MAX_AGE=0
# DB_CONN_HEALTH_CHECKS=True

# ============================================================
# AI Provider credentials
# ============================================================
# Uncomment and fill in the provider(s) you want to use.
# You do NOT need any of these to run the project — the built-in
# Training provider works without any API key.
#
# After adding a key here, go to:
#   Admin → AI Hub → Provider configs → add a new provider
# and set api_key_env_var to the variable name below
# (e.g. OPENAI_API_KEY).
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ── Anthropic ───────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ── Azure OpenAI ────────────────────────────────────────────
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/

# ============================================================
# GAME feature flags
# ============================================================
# DEBUG development defaults these flags on. Production defaults them off and
# requires explicit opt-in for each subsystem, so they also work as kill switches.
#
# AI_HUB_GAME_GOALS_ENABLED=True
# AI_HUB_GAME_SCHEDULER_ENABLED=True
# AI_HUB_GAME_ACTION_DISPATCH_ENABLED=True
# AI_HUB_GAME_MEMORY_ENABLED=True
# AI_HUB_GAME_RESUME_ENABLED=True
# AI_HUB_GAME_DELEGATION_ENABLED=True

# Transitional runtime flags. Defaults shown match _core/settings.py.
# AI_HUB_UNIFIED_TOOL_RUNTIME_ENABLED=False
# AI_HUB_DEFAULT_AGENT_TOOL_RUNTIME=resolved
# AI_HUB_LEGACY_EAGER_KNOWLEDGE_CONTEXT_ENABLED=False
# AI_HUB_MAX_TOOL_ROUNDS_PER_AGENT_CALL=3
# AI_HUB_MAX_TOOL_OBSERVATION_CHARS=12000

# ── Ollama (local LLM — no API key required) ─────────────────
# Install Ollama from https://ollama.ai and run a model:
#   ollama pull qwen3:8b
# Then set the URL to your Ollama instance:
# OLLAMA_BASE_URL=http://192.168.2.132:11434
#
# To seed the Ollama GAME agents after setting this variable:
#   python manage.py seed_ollama_agents
#   python manage.py run_doc_sync
